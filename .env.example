# ============================================================
# RockBox — Variables de entorno
# Copia este archivo a .env.local y rellena los valores.
# NUNCA subas .env.local ni valores reales a Git.
# ============================================================

# --- Supabase ---
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# --- YouTube Data API v3 ---
# https://console.cloud.google.com/ -> APIs & Services -> Credentials
YOUTUBE_API_KEY=tu-youtube-api-key

# --- Redis ---
# En local con docker compose: redis://redis:6379
# En local sin docker:         redis://localhost:6379
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Secreto para firmar los JWT de sesión de administrador (mín. 32 chars).
# Genera uno con: openssl rand -base64 32
AUTH_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# --- App ---
# URL pública base usada para construir los enlaces de los QR.
NEXT_PUBLIC_APP_URL=http://localhost:3000
